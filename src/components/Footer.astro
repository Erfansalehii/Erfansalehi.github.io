---
import { navigation, siteConfig, withBase } from '../site-config';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-grid">
    <div>
      <a class="brand" href={withBase('/')}>
        <span class="brand-mark" aria-hidden="true">YN</span>
        <span>{siteConfig.name}</span>
      </a>
      <p class="footer-note">A fast, accessible portfolio built with Astro and Markdown.</p>
    </div>
    <nav class="footer-nav" aria-label="Footer navigation">
      {navigation.map((item) => <a href={withBase(item.href)}>{item.label}</a>)}
    </nav>
    <div class="footer-meta">
      <span>© {year} {siteConfig.name}</span>
      <span>Built for GitHub Pages</span>
    </div>
  </div>
</footer>
