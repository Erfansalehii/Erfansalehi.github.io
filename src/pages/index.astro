---
import { getCollection, getEntry, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import PostCard from '../components/PostCard.astro';
import Icon from '../components/Icon.astro';
import { siteConfig, withBase } from '../site-config';

const home = await getEntry('pages', 'home');
if (!home) throw new Error('Missing src/content/pages/home.md');
const { Content } = await render(home);
const projects = (await getCollection('projects')).filter((item) => item.data.featured).slice(0, 2);
const posts = (await getCollection('posts', ({ data }) => !data.draft))
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf())
  .slice(0, 3);
---

<BaseLayout title={siteConfig.name} description={home.data.description}>
  <section class="hero container">
    <div class="hero-copy reveal">
      <p class="eyebrow">{siteConfig.availability}</p>
      <h1>Ideas into <span class="gradient-text">useful work.</span></h1>
      <p class="hero-description">{siteConfig.description}</p>
      <div class="hero-actions">
        <a class="button" href={withBase('/projects/')}>Explore projects <Icon name="arrow" /></a>
        <a class="button button-secondary" href={withBase('/contact/')}>Start a conversation</a>
      </div>
    </div>
    <div class="hero-art reveal" aria-hidden="true">
      <div class="orbit"></div>
      <div class="orbit orbit-two"></div>
      <div class="orb"></div>
      <div class="hero-stamp">Creative<br />portfolio</div>
    </div>
  </section>

  <div class="divider"></div>

  <section class="section container">
    <div class="section-heading reveal">
      <div><span class="section-label">Selected work</span><h2>Projects with purpose and polish.</h2></div>
      <p>Research and data-science projects connecting machine learning with real engineering and decision-making challenges.</p>
    </div>
    <div class="project-grid">
      {projects.map((project) => <ProjectCard project={project} />)}
    </div>
    <p style="margin-top: 2rem"><a class="text-link" href={withBase('/projects/')}>View every project <Icon name="arrow" size={17} /></a></p>
  </section>

  <section class="section-tight container">
    <div class="content-grid">
      <div class="prose reveal"><span class="section-label">Introduction</span><Content /></div>
      <aside class="side-card reveal" aria-label="Profile summary">
        <dl>
          <div><dt>Role</dt><dd>{siteConfig.role}</dd></div>
          <div><dt>Based in</dt><dd>{siteConfig.location}</dd></div>
          <div><dt>Focus</dt><dd>Computer vision & applied AI</dd></div>
        </dl>
      </aside>
    </div>
  </section>

  <section class="section container">
    <div class="section-heading reveal">
      <div><span class="section-label">From the blog</span><h2>Notes on the work behind the work.</h2></div>
      <p>Publish as many Markdown posts as your repository and GitHub Pages build limits allow.</p>
    </div>
    <div class="post-grid">{posts.map((post) => <PostCard post={post} />)}</div>
  </section>

  <section class="section container">
    <div class="cta reveal">
      <span class="section-label">Let’s connect</span>
      <h2>Have an interesting problem to solve?</h2>
      <p>Connect with me to discuss applied AI, computer vision, data science, MLOps, or intelligent manufacturing.</p>
      <a class="button" href={withBase('/contact/')}>Contact me <Icon name="arrow" /></a>
    </div>
  </section>
</BaseLayout>
