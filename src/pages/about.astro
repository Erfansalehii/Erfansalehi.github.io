---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import { siteConfig } from '../site-config';
const page = await getEntry('pages', 'about');
if (!page) throw new Error('Missing about content');
const { Content } = await render(page);
---

<BaseLayout title={page.data.title} description={page.data.description}>
  <PageHero {...page.data} />
  <section class="section-tight container content-grid">
    <article class="prose reveal"><Content /></article>
    <aside class="side-card reveal">
      <dl>
        <div><dt>Name</dt><dd>{siteConfig.name}</dd></div>
        <div><dt>Professional title</dt><dd>{siteConfig.role}</dd></div>
        <div><dt>Location</dt><dd>{siteConfig.location}</dd></div>
        <div><dt>Availability</dt><dd>{siteConfig.availability}</dd></div>
      </dl>
    </aside>
  </section>
</BaseLayout>
