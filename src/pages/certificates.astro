---
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
const page = await getEntry('pages', 'certificates');
if (!page) throw new Error('Missing certificates page content');
const certificates = await getCollection('certificates');
---

<BaseLayout title={page.data.title} description={page.data.description}>
  <PageHero {...page.data} />
  <section class="section-tight container">
    <div class="certificate-grid">
      {certificates.map((certificate) => (
        <article class="certificate-card reveal">
          {certificate.data.image ? (
            <img class="certificate-image" src={certificate.data.image} alt={`${certificate.data.title} certificate`} loading="lazy" />
          ) : (
            <span class="certificate-seal"><Icon name="spark" /></span>
          )}
          <div class="certificate-copy">
            <h2>{certificate.data.title}</h2>
            <p>{certificate.data.issuer}{certificate.data.issuedAt ? ` · ${certificate.data.issuedAt.getFullYear()}` : ''}</p>
            <ul class="tag-list">{certificate.data.skills.map((skill) => <li>{skill}</li>)}</ul>
            <div class="card-links">
              {certificate.data.credentialUrl && <a href={certificate.data.credentialUrl} target="_blank" rel="noreferrer">Verify online <Icon name="external" size={16} /></a>}
              {certificate.data.document && <a href={certificate.data.document} target="_blank" rel="noreferrer">View document <Icon name="external" size={16} /></a>}
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>
