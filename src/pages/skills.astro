---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import skillsData from '../data/skills.json';
const page = await getEntry('pages', 'skills');
if (!page) throw new Error('Missing skills content');
const { Content } = await render(page);
const groups = skillsData.skillGroups;
---

<BaseLayout title={page.data.title} description={page.data.description}>
  <PageHero {...page.data} />
  <section class="section-tight container">
    <div class="skills-grid">
      {groups.map((group, index) => (
        <article class="skill-card reveal">
          <span class="skill-index">0{index + 1}</span>
          <h2>{group.title}</h2><p>{group.description}</p>
          <ul>{group.items.map((item) => <li>{item}</li>)}</ul>
        </article>
      ))}
    </div>
    <article class="prose reveal" style="margin-top: 4rem"><Content /></article>
  </section>
</BaseLayout>
