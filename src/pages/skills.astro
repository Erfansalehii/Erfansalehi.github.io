---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
const page = await getEntry('pages', 'skills');
if (!page) throw new Error('Missing skills content');
const { Content } = await render(page);
const groups = [
  { title: 'Core expertise', text: 'Describe the capabilities you rely on most.', items: ['Skill one', 'Skill two', 'Skill three'] },
  { title: 'Tools & technology', text: 'List the tools that support your best work.', items: ['Tool one', 'Tool two', 'Tool three'] },
  { title: 'Ways of working', text: 'Show how you collaborate and deliver.', items: ['Practice one', 'Practice two', 'Practice three'] },
];
---

<BaseLayout title={page.data.title} description={page.data.description}>
  <PageHero {...page.data} />
  <section class="section-tight container">
    <div class="skills-grid">
      {groups.map((group, index) => (
        <article class="skill-card reveal">
          <span class="skill-index">0{index + 1}</span>
          <h2>{group.title}</h2><p>{group.text}</p>
          <ul>{group.items.map((item) => <li>{item}</li>)}</ul>
        </article>
      ))}
    </div>
    <article class="prose reveal" style="margin-top: 4rem"><Content /></article>
  </section>
</BaseLayout>
